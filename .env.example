# Copy this file to .env and fill in your values
# NEVER commit .env to git

# PostgreSQL connection string from Supabase
# Found in: Supabase Dashboard → Project Settings → Database → Connection String → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Secret key for signing JWTs — use a long random string
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Port for local development
PORT=3000

# Frontend URL for CORS (your deployed frontend domain, or * for dev)
FRONTEND_URL=*
